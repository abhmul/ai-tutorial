{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/destructive-guard.sh\"",
            "statusMessage": "Checking command policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/auto-mode.sh\"",
            "statusMessage": "Checking auto approval"
          }
        ]
      }
    ]
  }
}
